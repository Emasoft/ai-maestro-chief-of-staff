#!/usr/bin/env bash
# commit-msg hook: stamp the governance self-id trailer on every commit.
# Auto-generated by scripts/publish.py. Do NOT edit by hand — every
# publish.py run rewrites this file from its inline template.
#
# Appends `Agent: ai-maestro-chief-of-staff` (the plugin slug) as a git
# trailer (commit-discipline + PRRD G1.1). FAIL-OPEN: always exits 0, because
# a rejecting commit-msg hook would block the commit — the trailer is advisory,
# never a gate. IDEMPOTENT: `--if-exists doNothing` leaves any existing Agent
# trailer in place, so amend/rebase never double-stamps.

set -u
MSG_FILE="${1:-}"
[ -n "${MSG_FILE}" ] || exit 0
[ -f "${MSG_FILE}" ] || exit 0

git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Agent: ai-maestro-chief-of-staff" "${MSG_FILE}" 2>/dev/null || true

exit 0
