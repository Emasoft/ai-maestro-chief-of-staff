{
  "description": "Chief of Staff hooks - agent lifecycle management, resource monitoring, and session coordination",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_session_start.py"],
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_session_end.py"],
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_resource_check.py"],
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_heartbeat_check.py"],
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["python3", "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_stop_check.py"],
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
