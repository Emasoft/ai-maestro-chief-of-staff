{
  "description": "Chief of Staff hooks - agent lifecycle management, resource monitoring, and session coordination",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_session_start.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_session_end.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_resource_check.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_heartbeat_check.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/scripts/amcos_stop_check.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
